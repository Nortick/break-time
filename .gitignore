# - copies of the bar's own built-in animations (reference only, not ours to publish)
/animations/
# - backups, old copies and working notes
/backup-*/
/worker-clock-src/
/Claude outputs/
CLAUDE-NOTES.md
# - build helpers made by npm run bake / npm run sfx, and the sound preview
tools/.bake.cjs
tools/.sfx.cjs
tools/sfx-preview.*

# src/animations, src/sounds and src/baked.ts ARE committed on purpose:
